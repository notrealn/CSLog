generator client {
    provider = "prisma-client"
    output   = "./generated"
}

datasource db {
    provider = "sqlite"
}

model Substance {
    id             Int           @id @default(autoincrement())
    date           DateTime      @default(now())
    productName    String
    lotNumber      String
    materialType   String
    unit           String
    initialGross   Float?
    initialTare    Float?
    initialNet     Float
    container      String?
    expirationDate DateTime?
    recievedDate   DateTime
    transactions   Transaction[]
}

model Transaction {
    id             Int       @id @default(autoincrement())
    substance      Substance @relation(fields: [substanceId], references: [id])
    substanceId    Int
    purpose        String
    amount         Float
    amountReturned Float?
    date           DateTime  @default(now())

    user       User  @relation("User", fields: [userId], references: [id])
    userId     Int
    verifier   User? @relation("Verifier", fields: [verifierId], references: [id])
    verifierId Int?
}

model User {
    id             Int    @id @default(autoincrement())
    name           String @unique
    initials       String
    hashedPassword String
    role           String @default("REVIEWER")

    used     Transaction[] @relation("User")
    verified Transaction[] @relation("Verifier")
}
